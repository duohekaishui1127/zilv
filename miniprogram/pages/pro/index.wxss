.pro-page{background:#edf1ef}.pro-hero{padding:18rpx 0 28rpx}.pixel-kicker,.section-kicker{font:900 20rpx monospace;letter-spacing:4rpx;color:#315f4a}.pro-title{margin-top:18rpx;color:#111827;font-size:52rpx;font-weight:900;line-height:1.22}.pro-sub{margin-top:14rpx;color:#6b7280;font-size:26rpx;line-height:1.65}.status-stamp{margin-top:28rpx;padding:22rpx;border:2rpx solid #9ca3af;background:#fff;box-shadow:7rpx 7rpx 0 rgba(17,24,39,.08)}.status-stamp.active{border-color:#315f4a;background:#e7f2eb}.status-name{font:900 25rpx monospace;color:#111827}.status-desc{margin-top:7rpx;color:#6b7280;font-size:23rpx}.section-kicker{margin:28rpx 0 14rpx;color:#6b7280}.pro-kicker{color:#244b38}.feature-card{padding:22rpx;border:2rpx solid #d7dbe0;border-radius:9rpx;background:#fff}.pro-card{border-color:#315f4a;box-shadow:6rpx 6rpx 0 rgba(49,95,74,.11)}.feature{display:flex;gap:18rpx;padding:19rpx 0;border-bottom:1rpx solid #edf0ee}.feature:last-child{border-bottom:0}.feature-mark{flex:0 0 auto;display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;border:2rpx solid #111827;background:#f5f6f7;font:900 18rpx monospace}.pro-mark{border-color:#315f4a;background:#dceee4;color:#244b38}.feature-title{color:#111827;font-size:26rpx;font-weight:800}.feature-copy{margin-top:5rpx;color:#8a8f98;font-size:22rpx;line-height:1.5}.beta-note{margin-top:26rpx;padding:24rpx;border:2rpx dashed #315f4a;background:#f6fbf8}.beta-title{color:#244b38;font-weight:900}.beta-copy{margin-top:9rpx;color:#557362;font-size:23rpx;line-height:1.65}.buy-button{width:100%;margin-top:26rpx;border:2rpx solid #111827;border-radius:8rpx;background:#dfe3e1;color:#6b7280;font-weight:900}.buy-button.enabled{background:#111827;color:#fff}.buy-button::after{border:0}.payment-note{margin:16rpx 6rpx 0;color:#8a8f98;font-size:20rpx;line-height:1.55;text-align:center}
