.textarea{width:100%;background:#f3f4f6;border-radius:16rpx;padding:20rpx;margin-top:10rpx;min-height:220rpx;box-sizing:border-box;line-height:1.6}.photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:20rpx}.photo-item{position:relative}.photo{width:100%;height:200rpx;border-radius:14rpx;background:#eef0f3}.photo-remove{position:absolute;right:8rpx;top:8rpx;width:44rpx;height:44rpx;border-radius:50%;background:rgba(0,0,0,.6);color:white;display:flex;align-items:center;justify-content:center;font-size:32rpx}.pose-label{margin-top:8rpx;padding:8rpx;background:#f3f4f6;border-radius:10rpx;text-align:center;font-size:22rpx;color:#4b5563}.delete-btn{margin-top:18rpx}
