.filter-scroll{white-space:nowrap;margin-bottom:20rpx}.filter-row{display:inline-flex;gap:12rpx}.filter-chip{display:inline-block;padding:14rpx 24rpx;border-radius:999rpx;background:#fff;color:#6b7280}.filter-chip-active{background:#111827;color:#fff}.note-card{position:relative}.note-title{font-size:32rpx;font-weight:700;margin-top:16rpx}.note-content{color:#4b5563;line-height:1.65;margin-top:12rpx;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}.tag-row{display:flex;gap:10rpx;flex-wrap:wrap;margin-top:14rpx}.mini-tag{font-size:22rpx;color:#6b7280}.thumb-row{display:flex;gap:10rpx;margin-top:18rpx;position:relative}.thumb{width:150rpx;height:150rpx;border-radius:14rpx;background:#eef0f3}.more-photo{width:80rpx;height:150rpx;display:flex;align-items:center;justify-content:center;color:#6b7280}.load-more{width:100%;margin-top:10rpx}
