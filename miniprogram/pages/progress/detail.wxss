.journey-dates { display:flex; align-items:center; gap:18rpx; }
.journey-date { flex:0 0 auto; }
.journey-date-right { text-align:right; }
.journey-line { flex:1; height:3rpx; border-radius:999rpx; background:linear-gradient(90deg,#cfd8d3,#6f907e); }
.journey-date .value { margin-top:7rpx; }
.journey-metrics { margin-top:28rpx; }
.journey-value { margin-top:9rpx; color:#1f4937; font-size:34rpx; font-weight:800; }
.journey-note { margin-top:24rpx; margin-bottom:0; }
.linked-plan { display:flex; align-items:center; gap:14rpx; padding:20rpx 0; border-bottom:1rpx solid #eef0f2; }
.linked-plan:last-child { border-bottom:0; }
.linked-dot { width:14rpx; height:14rpx; flex:0 0 14rpx; border-radius:50%; background:#6f907e; }
.result-options { display:flex; flex-wrap:wrap; gap:12rpx; margin:24rpx 0 28rpx; }
.result-option { padding:13rpx 20rpx; border-radius:999rpx; color:#60646c; background:#eef0f3; font-size:24rpx; }
.result-option-active { color:#fff; background:#315f4a; }
.review-input { min-height:190rpx; }
.detail-row { display:flex; justify-content:space-between; gap:20rpx; padding:18rpx 0; border-bottom:1rpx solid #eef0f2; }
.detail-row:last-of-type { border-bottom:0; }
