.other-card { padding-top: 24rpx; padding-bottom: 24rpx; }
.progress-entry { border:1rpx solid #dfe9e3; background:linear-gradient(135deg,#fff,#f1f8f4); }
.progress-entry-arrow { color:#557362; font-size:38rpx; }
.other-toggle { min-height: 66rpx; }
.other-chevron { min-width: 34rpx; color: #8a8f98; font-size: 30rpx; text-align: center; }
.other-list { margin-top: 14rpx; padding-top: 2rpx; border-top: 1rpx solid #eef0f2; }
.data-note { margin-top: 20rpx; padding: 18rpx; border-radius: 16rpx; background: #f7f8fa; color: #8a8f98; font-size: 23rpx; line-height: 1.55; }
.avatar-button { flex:0 0 auto; width:92rpx; height:92rpx; margin:0; padding:0; border:0; border-radius:24rpx; background:transparent; overflow:hidden; }
.avatar-button::after { border:0; }
.profile-avatar { width:92rpx; height:92rpx; border-radius:24rpx; background:#eef0f3; }
.avatar-placeholder { display:flex; align-items:center; justify-content:center; color:#6b7280; font-size:42rpx; }
.avatar-hint { margin-top:5rpx; color:#9ca3af; font-size:20rpx; }
.profile-identity { min-width:0; flex:1; }
.profile-name-wrap { min-width:0; flex:1; }
.profile-nickname { width:100%; height:48rpx; color:#15171a; font-size:34rpx; font-weight:700; line-height:48rpx; }
.profile-nickname-placeholder { color:#9ca3af; font-weight:500; }
.profile-completion-hint { margin-top:20rpx; padding-top:18rpx; border-top:1rpx solid #eef0f2; color:#6b7280; font-size:23rpx; }
.reminder-setting { min-height:88rpx; box-sizing:border-box; }
.reminder-mask { position:fixed; inset:0; z-index:120; display:flex; align-items:flex-end; background:rgba(17,24,39,.38); }
.reminder-sheet { width:100%; max-height:80vh; overflow-y:auto; box-sizing:border-box; padding:16rpx 30rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius:28rpx 28rpx 0 0; background:#fff; }
.reminder-sheet-handle { width:72rpx; height:8rpx; margin:0 auto 16rpx; border-radius:999rpx; background:#d8dde2; }
.reminder-sheet-close { display:flex; align-items:center; justify-content:center; min-width:88rpx; min-height:88rpx; color:#6b7280; font-size:42rpx; }
.reminder-sheet-row { min-height:104rpx; padding:20rpx 0; border-bottom:1rpx solid #eef0f2; }
.reminder-time { color:#315f4a; font-weight:700; font-variant-numeric:tabular-nums; }
.reminder-time text { margin-left:14rpx; color:#9ca3af; }
.reminder-feedback { margin-top:18rpx; color:#6b7280; font-size:25rpx; line-height:1.6; }
.reminder-feedback.danger { color:#c2413b; }
.reminder-permission { margin-top:24rpx; }
.reminder-permission .sub { font-size:23rpx; }
.membership-strip { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-top:22rpx; padding:18rpx; border:2rpx solid #d7dbe0; border-radius:10rpx; background:#f6f7f9; }
.membership-pro { border-color:#315f4a; background:#edf6f1; box-shadow:5rpx 5rpx 0 rgba(49,95,74,.12); }
.membership-title { color:#1f2937; font-family:monospace; font-size:22rpx; font-weight:800; letter-spacing:1rpx; }
.membership-sub { margin-top:5rpx; color:#6b7280; font-size:21rpx; }
.membership-code { flex:0 0 auto; color:#315f4a; font-family:monospace; font-size:20rpx; font-weight:800; }
.pro-inline { margin-left:8rpx; padding:3rpx 7rpx; border:1rpx solid #315f4a; border-radius:4rpx; color:#315f4a; font-size:17rpx; vertical-align:middle; }
