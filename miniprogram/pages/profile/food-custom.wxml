<view class="container"><view class="card"><view class="h2">添加自定义食物</view><view class="sub">按包装营养成分表填写“每100g”数据</view><view class="field"><view class="label">名称</view><input class="input" data-key="name" value="{{name}}" bindinput="input" placeholder="例如：XX全麦面包"/></view><view class="field"><view class="label">品牌</view><input class="input" data-key="brand" value="{{brand}}" bindinput="input"/></view><view class="field"><view class="label">热量 kcal / 100g</view><input class="input" type="digit" data-key="energyKcalPer100" value="{{energyKcalPer100}}" bindinput="input"/></view><view class="metric-grid"><view><view class="label">蛋白质 g</view><input class="input" type="digit" data-key="proteinPer100" value="{{proteinPer100}}" bindinput="input"/></view><view><view class="label">碳水 g</view><input class="input" type="digit" data-key="carbPer100" value="{{carbPer100}}" bindinput="input"/></view><view><view class="label">脂肪 g</view><input class="input" type="digit" data-key="fatPer100" value="{{fatPer100}}" bindinput="input"/></view></view><button class="btn" style="margin-top:28rpx" loading="{{saving}}" bindtap="save">保存食物</button></view></view>
