<view class="container">
  <view class="card">
    <view class="h2">今日卡片</view>
    <view class="sub">调整顺序或暂时隐藏；隐藏不会删除任务和数据。今日任务始终保留。</view>
    <view class="setting-card" wx:for="{{cards}}" wx:key="key">
      <view class="flex-1"><view class="value">{{item.label}}</view><view class="sub">{{item.description}}</view></view>
      <view class="card-actions"><button class="order-button" disabled="{{index === 0}}" data-index="{{index}}" data-offset="-1" bindtap="move">↑</button><button class="order-button" disabled="{{index === cards.length - 1}}" data-index="{{index}}" data-offset="1" bindtap="move">↓</button><switch wx:if="{{!item.locked}}" checked="{{item.visible}}" data-key="{{item.key}}" bindchange="toggle"/><view wx:else class="locked-tag">固定</view></view>
    </view>
  </view>
  <button class="btn" loading="{{saving}}" bindtap="save">保存设置</button>
</view>
