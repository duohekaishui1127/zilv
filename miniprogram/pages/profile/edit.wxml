<view class="container"><view class="card"><view class="field"><view class="label">昵称</view><input class="input" data-key="nickname" value="{{nickname}}" bindinput="input"/></view><view class="field"><view class="label">性别（用于基础代谢估算）</view><picker mode="selector" range="{{sexOptions}}" value="{{sexIndex}}" bindchange="sex"><view class="input">{{sexOptions[sexIndex]}}</view></picker></view><view class="field"><view class="label">生日</view><picker mode="date" value="{{birthday}}" bindchange="date"><view class="input">{{birthday}}</view></picker></view><view class="field"><view class="label">身高 cm</view><input class="input" type="digit" data-key="heightCm" value="{{heightCm}}" bindinput="input"/></view><view class="field"><view class="label">当前目标</view><picker mode="selector" range="{{goalOptions}}" value="{{goalIndex}}" bindchange="goal"><view class="input">{{goalOptions[goalIndex]}}</view></picker></view><view class="field"><view class="label">基础活动水平（主动运动单独记录，避免重复计算）</view><picker mode="selector" range="{{activityOptions}}" value="{{activityIndex}}" bindchange="activity"><view class="input">{{activityOptions[activityIndex]}}</view></picker></view><view class="row"><view class="field" style="flex:1"><view class="label">蛋白质 g/kg</view><input class="input" type="digit" data-key="proteinRatio" value="{{proteinRatio}}" bindinput="input"/></view><view class="field" style="flex:1"><view class="label">脂肪 g/kg</view><input class="input" type="digit" data-key="fatRatio" value="{{fatRatio}}" bindinput="input"/></view></view><view class="field"><view class="label">每日热量调整 kcal</view><input class="input" type="number" data-key="targetCalorieAdjustment" value="{{targetCalorieAdjustment}}" bindinput="input"/><view class="sub">减脂默认 -300；维持 0；增肌 +200，可自行修改。</view></view><button class="btn" loading="{{saving}}" bindtap="save">保存并重新计算</button></view></view>
