<active-timer id="activeTimerBar"/>
<view class="container" wx:if="{{profile}}">
  <view class="card profile-card">
    <view class="row"><view class="row-start profile-identity"><button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" loading="{{avatarSaving}}"><image wx:if="{{profile.user.avatar}}" class="profile-avatar" src="{{profile.user.avatar}}" mode="aspectFill"/><view wx:else class="profile-avatar avatar-placeholder">＋</view></button><view class="profile-name-wrap"><input class="profile-nickname" type="nickname" maxlength="30" confirm-type="done" value="{{nicknameDraft}}" placeholder="填写微信昵称" placeholder-class="profile-nickname-placeholder" bindinput="nicknameInput" bindblur="nicknameBlur" bindnicknamereview="nicknameReview"/><view class="sub">身份码 {{profile.membership.identityCode}}</view><view class="sub">好友码 {{profile.user.shareCode}}</view><view class="avatar-hint">点击头像或昵称即可修改</view></view></view><button class="btn btn-small btn-light" bindtap="copy">复制好友码</button></view>
    <view class="membership-strip {{profile.membership.isPro ? 'membership-pro' : ''}}" data-url="/pages/pro/index" bindtap="go">
      <view><view class="membership-title">{{profile.membership.betaActive ? 'BETA PRO · 公测权益' : (profile.membership.isPro ? 'PRO · 永久权益' : 'FREE · 基础版')}}</view><view class="membership-sub" wx:if="{{profile.membership.betaActive}}">完整 Pro 体验剩余 {{profile.membership.remainingDays}} 天 · 到期不自动扣费</view><view class="membership-sub" wx:else>基础功能和你的历史数据始终保留</view></view>
      <view class="membership-code">{{profile.membership.identityCode}}  ›</view>
    </view>
    <view wx:if="{{profileIncomplete}}" class="profile-completion-hint">完善头像和昵称，让好友更容易认出你</view>
  </view>
  <view class="card progress-entry" data-url="/pages/progress/index" bindtap="go">
    <view class="row"><view><view class="h2">我的进步</view><view class="sub">纪念章、目标、习惯和考试的完整历程</view></view><view class="progress-entry-arrow">›</view></view>
  </view>
  <view class="card">
    <view class="list-item row reminder-setting">
      <picker class="flex-1" mode="time" value="{{profile.user.checkinReminderTime || '21:00'}}" disabled="{{!profile.user.checkinReminderEnabled || reminderSaving}}" bindchange="reminderTimeChange">
        <view><view class="value">打卡提醒</view><view class="sub">{{profile.user.checkinReminderEnabled ? (profile.user.checkinReminderTime || '21:00') + '，今日任务未全部完成才提醒' : '不提醒'}}</view></view>
      </picker>
      <switch checked="{{profile.user.checkinReminderEnabled}}" disabled="{{reminderSaving}}" bindchange="reminderToggle" color="#222222"/>
    </view>
    <view class="list-item row" data-url="/pages/notes/index" bindtap="go"><view><view class="value">我的历程</view><view class="sub">体态照片、学习笔记和训练复盘</view></view><view>›</view></view>
    <view class="list-item row" data-url="/pages/record/body" bindtap="go"><view><view class="value">身体数据</view><view class="sub {{profile.weightStatus.needUpdate ? 'danger' : ''}}">{{profile.weightSummary}} · 可附备注留作复盘</view></view><view>›</view></view>
    <view class="list-item row" data-url="/pages/report/week" bindtap="go"><view><view class="value">成长复盘 <text class="pro-inline">PRO</text></view><view class="sub">周报、月报、90 天总结与分享海报</view></view><view>›</view></view>
  </view>
  <view class="card other-card">
    <view class="row other-toggle" bindtap="toggleOther"><view><view class="value">其他</view><view class="sub">档案、显示、隐私与帮助</view></view><view class="other-chevron">{{otherExpanded ? '⌃' : '⌄'}}</view></view>
    <view wx:if="{{otherExpanded}}" class="other-list">
      <view class="list-item row" data-url="/pages/profile/edit" bindtap="go"><view><view class="value">身体与营养档案</view><view class="sub">身高、生日、目标、活动水平</view></view><view>›</view></view>
      <view class="list-item row" data-url="/pages/profile/home-settings" bindtap="go"><view><view class="value">今日页设置</view><view class="sub">选择“今日”中显示的自律数据</view></view><view>›</view></view>
      <view class="list-item row" data-url="/pages/profile/privacy" bindtap="go"><view><view class="value">隐私设置</view><view class="sub">控制好友可见范围</view></view><view>›</view></view>
      <view class="list-item row" data-url="/pages/pro/index" bindtap="go"><view><view class="value">ZILV Pro <text class="pro-inline">{{profile.membership.isPro ? 'ACTIVE' : 'PRO'}}</text></view><view class="sub">Free / Pro 权益、公测剩余时间与买断入口</view></view><view>›</view></view>
      <view class="list-item row" data-url="/pages/legal/data" bindtap="go"><view><view class="value">账号与数据</view><view class="sub">清空部分记录、数据权利与永久注销</view></view><view>›</view></view>
      <view class="list-item row" data-url="/pages/legal/privacy" bindtap="go"><view><view class="value">隐私政策</view><view class="sub">我们收集什么、为什么以及如何删除</view></view><view>›</view></view>
      <view class="list-item row" data-url="/pages/legal/terms" bindtap="go"><view><view class="value">用户服务协议</view><view class="sub">服务边界、公测与 Pro 规则</view></view><view>›</view></view>
      <view class="list-item row" data-url="/pages/profile/food-custom" bindtap="go"><view><view class="value">自定义食物</view><view class="sub">添加包装食品或自己的食物数据</view></view><view>›</view></view>
      <view wx:if="{{!profile.isFeedbackAdmin}}" class="list-item row" data-url="/pages/feedback/index" bindtap="go"><view><view class="value">用户反馈</view><view class="sub">提交反馈并查看开发者回复</view></view><view>›</view></view>
      <view wx:else class="list-item row" data-url="/pages/feedback/admin" bindtap="go"><view><view class="value">用户反馈</view><view class="sub">查看并回复用户提交的反馈</view></view><view>›</view></view>
      <view class="list-item row" data-url="/pages/profile/about" bindtap="go"><view><view class="value">关于与诊断</view><view class="sub">版本、环境与问题定位信息</view></view><view>›</view></view>
      <view class="data-note">BMR、日常消耗和运动热量均为估算，用于自我记录，不代替医学或营养诊疗。</view>
    </view>
  </view>
</view>
