<view class="container report-page">
  <view class="hero report-hero">
    <view class="pixel-kicker">REVIEW / GROWTH</view>
    <view class="h1">成长复盘</view>
    <view class="sub">不是给自己打分，而是看看这一段时间究竟留下了什么</view>
  </view>

  <view class="period-tabs">
    <view wx:for="{{periods}}" wx:key="value" class="period-tab {{selectedPeriod === item.value ? 'period-tab-active' : ''}}" data-period="{{item.value}}" bindtap="selectPeriod">{{item.label}}</view>
  </view>

  <view wx:if="{{loading && !report}}" class="empty">正在整理这一段时间…</view>
  <view wx:elif="{{error && !report}}" class="card error-card"><view class="value">复盘生成失败</view><view class="sub">{{error}}</view><button class="btn btn-small" style="margin-top:20rpx" bindtap="retry">重新加载</button></view>

  <block wx:if="{{report}}">
    <view wx:if="{{report.locked}}" class="pro-lock-card">
      <view class="pro-lock-kicker">PRO REVIEW</view><view class="h2">完整成长复盘属于 Pro</view>
      <view class="sub">周报、月报、90 天复盘、分享海报和高级历史趋势都会保留。基础功能与原始数据始终可用。</view>
      <view class="pro-lock-note"><block wx:if="{{report.membership.betaUser}}">你的 {{report.trialDays}} 天公测 Pro 已结束，历史数据仍然完整保留。</block><block wx:else>当前新用户可获得 {{report.trialDays}} 天完整 Pro 体验。</block></view>
      <button class="btn pro-lock-button" bindtap="goPro">查看 Free / Pro 区别</button>
    </view>

    <block wx:else>
      <view class="report-period-card">
        <view><view class="report-period-label">{{report.period.label}}</view><view class="sub">{{report.period.startDate}} ～ {{report.period.endDate}}</view></view>
        <view class="identity-stamp">{{report.identityCode}}</view>
      </view>

      <view class="big-stat-grid">
        <view class="big-stat"><view class="big-stat-number">{{report.current.summary.activeDays}}</view><view class="big-stat-label">天有行动</view></view>
        <view class="big-stat"><view class="big-stat-number">{{report.current.summary.completedTasks}}</view><view class="big-stat-label">项计划完成</view></view>
        <view class="big-stat"><view class="big-stat-number">{{report.current.summary.focusText}}</view><view class="big-stat-label">累计专注</view></view>
        <view class="big-stat"><view class="big-stat-number">{{report.completedGoals.length}}</view><view class="big-stat-label">个长期目标</view></view>
      </view>

      <view class="card pixel-card">
        <view class="row"><view class="h2">和上一段相比</view><view class="tag">仅作观察</view></view>
        <view class="compare-grid">
          <view wx:for="{{report.comparisonView}}" wx:key="label" class="compare-item"><view class="label">{{item.label}}</view><view class="compare-value compare-{{item.tone}}">{{item.text}}</view></view>
        </view>
      </view>

      <view class="card pixel-card">
        <view class="h2">这段时间，值得记住</view>
        <view wx:for="{{report.highlights}}" wx:key="*this" class="highlight-line"><view class="pixel-dot"></view><view>{{item}}</view></view>
        <view class="review-quote">“{{report.posterQuote}}”</view>
      </view>

      <view wx:if="{{report.unlockedBadges.length}}" class="card pixel-card" bindtap="goProgress">
        <view class="row"><view><view class="h2">新获得的纪念章</view><view class="sub">这一段时间新增 {{report.unlockedBadges.length}} 枚</view></view><view class="more-arrow">›</view></view>
        <view class="report-badges"><view wx:for="{{report.unlockedBadges}}" wx:key="id" class="mini-badge"><view class="mini-badge-symbol">{{item.symbol}}</view><view>{{item.title}}</view></view></view>
      </view>

      <view class="card pixel-card">
        <view class="row"><view class="h2">行动趋势</view><view class="sub">运动 / 学习</view></view>
        <canvas wx:if="{{hasActivity}}" type="2d" id="activityChart" class="trend-chart"></canvas>
        <view wx:else class="empty compact">这段时间还没有运动或学习时长记录</view>
      </view>

      <view class="card pixel-card" wx:if="{{hasWeight}}">
        <view class="row"><view class="h2">身体趋势</view><view class="tag" wx:if="{{report.current.summary.weightChange !== null}}">{{report.current.summary.weightChange > 0 ? '+' : ''}}{{report.current.summary.weightChange}} kg</view></view>
        <canvas type="2d" id="weightChart" class="trend-chart"></canvas>
        <view class="sub">趋势只用于个人记录，不代表医学或健康结论。</view>
      </view>

      <view class="poster-preview">
        <view class="poster-preview-kicker">MY PROGRESS / ZILV</view>
        <view class="poster-preview-title">{{report.period.label}}</view>
        <view class="poster-preview-grid">
          <view><text>{{report.current.summary.activeDays}}</text><view class="poster-small">天有行动</view></view>
          <view><text>{{report.current.summary.completedTasks}}</text><view class="poster-small">计划完成</view></view>
          <view><text>{{report.current.summary.focusText}}</text><view class="poster-small">累计专注</view></view>
          <view><text>{{report.completedGoals.length}}</text><view class="poster-small">长期目标</view></view>
        </view>
        <view class="poster-preview-quote">“{{report.posterQuote}}”</view>
        <view class="poster-preview-footer"><text>{{report.identityCode}}</text><text>自律 ZILV · 把长期目标，落实到今天</text></view>
      </view>

      <view class="poster-actions"><button class="btn btn-light" bindtap="savePoster" loading="{{posterRendering}}">保存海报</button><button class="btn btn-light" bindtap="sharePoster" loading="{{posterRendering}}">分享海报</button><button class="btn" open-type="share">分享小程序</button></view>
      <view class="share-note">海报只展示汇总数据，不会包含你的笔记正文、体重明细等私密内容；底部会保留轻量品牌水印。</view>
    </block>
  </block>

  <canvas type="2d" id="reportPoster" class="poster-canvas"></canvas>
</view>
