.range-tabs { display:flex; gap:12rpx; margin-bottom:20rpx; }
.range-tab { flex:1; text-align:center; padding:16rpx; border-radius:16rpx; background:#e5e7eb; color:#6b7280; }
.range-tab-active { background:#111827; color:#fff; font-weight:700; }
.summary-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin-bottom:20rpx; }
.summary-item { background:#fff; border-radius:20rpx; padding:24rpx; box-shadow:0 6rpx 24rpx rgba(17,24,39,.04); }
.summary-item .big { margin-top:8rpx; }
.body-metrics { margin-top:20rpx; }
.trend-chart { width:100%; height:360rpx; margin-top:20rpx; }
.chart-title { margin-top:26rpx; font-weight:700; }
.chart-legend { display:flex; gap:18rpx; font-size:23rpx; }
.legend-workout { color:#ea580c; }
.legend-study { color:#2563eb; }
.month-button { margin:0; padding:0 24rpx; min-width:68rpx; line-height:62rpx; background:#eef0f3; color:#111827; border-radius:14rpx; }
.month-button::after { border:none; }
.weekday-grid,.calendar-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:10rpx; }
.weekday-grid { margin-top:24rpx; }
.weekday { text-align:center; color:#8a8f98; font-size:22rpx; }
.calendar-grid { margin-top:12rpx; }
.calendar-day { aspect-ratio:1; border-radius:12rpx; display:flex; align-items:center; justify-content:center; position:relative; font-size:23rpx; background:#f3f4f6; }
.calendar-blank { background:transparent; }
.calendar-today { outline:3rpx solid #111827; }
.activity-0 { background:#f3f4f6; }
.activity-1 { background:#d1fae5; }
.activity-2 { background:#6ee7b7; }
.activity-3 { background:#34d399; }
.activity-4 { background:#059669; color:#fff; }
.checkin-dot { position:absolute; right:4rpx; bottom:3rpx; min-width:22rpx; height:22rpx; padding:0 3rpx; border-radius:999rpx; background:#111827; color:#fff; font-size:15rpx; line-height:22rpx; text-align:center; }
.calendar-summary { margin-top:22rpx; color:#6b7280; font-size:24rpx; line-height:1.6; }
.activity-legend { display:flex; align-items:center; justify-content:flex-end; gap:8rpx; margin-top:16rpx; color:#8a8f98; font-size:21rpx; }
.legend-box { width:24rpx; height:24rpx; border-radius:6rpx; }
