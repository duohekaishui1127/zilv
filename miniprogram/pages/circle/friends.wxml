<view class="container">
  <view class="card"><view class="h2">通过好友码添加</view><view class="row"><input class="input flex-1" value="{{shareCode}}" bindinput="input" placeholder="输入好友码"/><button class="btn btn-small" bindtap="find">查找</button></view><view wx:if="{{found}}" class="list-item row"><view class="row-start flex-1"><image wx:if="{{found.avatar}}" class="friend-list-avatar" src="{{found.avatar}}" mode="aspectFill"/><view wx:else class="friend-list-avatar avatar-fallback">{{found.initial}}</view><view><view class="value">{{found.nickname}}</view><view class="sub">好友码 {{found.shareCode}}</view></view></view><button class="btn btn-small" bindtap="add">添加</button></view></view>
  <view class="section-title" wx:if="{{requests.length}}">好友请求 <text class="request-count">{{requests.length}}</text></view><view class="card" wx:if="{{requests.length}}"><view class="list-item row" wx:for="{{requests}}" wx:key="friendship._id"><view class="row-start flex-1"><image wx:if="{{item.user.avatar}}" class="friend-list-avatar" src="{{item.user.avatar}}" mode="aspectFill"/><view wx:else class="friend-list-avatar avatar-fallback">{{item.user.initial}}</view><view class="flex-1"><view class="value">{{item.user.nickname}}</view><view class="sub">申请添加你为好友</view><view class="request-message" wx:if="{{item.friendship.requestMessage}}">“{{item.friendship.requestMessage}}”</view></view></view><view class="request-actions"><button class="btn btn-light btn-small" data-id="{{item.friendship._id}}" catchtap="reject">拒绝</button><button class="btn btn-small" data-id="{{item.friendship._id}}" catchtap="accept">接受</button></view></view></view>
  <view class="section-title" wx:if="{{outgoing.length}}">等待对方处理</view><view class="card" wx:if="{{outgoing.length}}"><view class="list-item row" wx:for="{{outgoing}}" wx:key="friendship._id"><view class="row-start flex-1"><image wx:if="{{item.user.avatar}}" class="friend-list-avatar" src="{{item.user.avatar}}" mode="aspectFill"/><view wx:else class="friend-list-avatar avatar-fallback">{{item.user.initial}}</view><view class="flex-1"><view class="value">{{item.user.nickname}}</view><view class="sub">好友申请已发送</view><view class="request-message" wx:if="{{item.friendship.requestMessage}}">“{{item.friendship.requestMessage}}”</view></view></view><button class="btn btn-light btn-small" data-id="{{item.friendship._id}}" catchtap="cancel">撤回</button></view></view>
  <view class="section-title">我的好友</view>
  <view class="card">
    <view class="list-item friend-row" wx:for="{{friends}}" wx:key="_id" data-id="{{item._id}}" bindtap="openFriend">
      <view class="row"><view class="row-start flex-1"><image wx:if="{{item.avatar}}" class="friend-list-avatar friend-main-avatar" src="{{item.avatar}}" mode="aspectFill"/><view wx:else class="friend-list-avatar friend-main-avatar avatar-fallback">{{item.initial}}</view><view class="flex-1"><view class="row-start"><view class="value">{{item.displayName}}</view><view wx:if="{{item.isAdministrator}}" class="tag">管理员</view><view wx:if="{{item.pinned}}" class="pin-tag">置顶</view><view wx:if="{{item.specialCare}}" class="care-tag">特别关心</view></view><view class="sub" wx:if="{{item.remark}}">昵称：{{item.nickname}}</view><view class="sub" wx:if="{{item.planStatus}}">今日总计划 {{item.planStatus.completed}} / {{item.planStatus.total}}</view><view class="sub" wx:else>对方已隐藏计划状态</view></view></view><view class="friend-arrow">›</view></view>
    </view>
    <view class="empty compact" wx:if="{{!friends.length}}">暂无好友</view>
  </view>
</view>
