<view class="container" wx:if="{{friend}}">
  <view class="hero row">
    <view class="row-start"><image wx:if="{{friend.avatar}}" class="friend-avatar" src="{{friend.avatar}}" mode="aspectFill"/><view wx:else class="friend-avatar">{{friend.initial}}</view><view><view class="h1">{{friend.displayName}}</view><view class="sub" wx:if="{{friend.remark}}">昵称：{{friend.nickname}}</view><view class="sub">好友码 {{friend.shareCode}}</view></view></view>
    <button class="more-button" bindtap="openSettings">•••</button>
  </view>
  <view class="section-title">当月打卡</view>
  <view class="card calendar-card" wx:if="{{calendarVisible}}">
    <view class="month-title">{{calendar.month}}</view>
    <view class="weekday-grid"><view class="weekday" wx:for="{{weekdayLabels}}" wx:key="*this">{{item}}</view></view>
    <view class="calendar-grid">
      <view wx:for="{{calendar.cells}}" wx:key="key" data-index="{{index}}" bindtap="openDay" class="calendar-day {{item.blank ? 'calendar-blank' : ''}} {{!item.blank && !item.inRange ? 'calendar-outside-range' : ''}} {{item.today ? 'calendar-today' : ''}}">
        <block wx:if="{{!item.blank}}"><view class="day-number">{{item.day}}</view><view wx:if="{{item.checkedIn}}" class="calendar-check">✓</view></block>
      </view>
    </view>
    <view class="calendar-summary">本月打卡 {{calendar.summary.checkedInDays}} 天</view>
    <view class="calendar-hint">全部可见计划完成后显示绿色对号，点击日期查看计划名称与进度</view>
  </view>
  <view class="card" wx:else><view class="empty compact">对方没有向你公开计划打卡记录</view></view>
  <view class="card day-card" wx:if="{{selectedDay}}">
    <view class="row"><view><view class="h2">{{selectedDay.title}}</view><view class="sub">可见任务 {{selectedDay.completed}} / {{selectedDay.total}}</view></view></view>
    <view class="list-item row task-row {{item.completed ? 'task-complete' : ''}}" wx:for="{{selectedDay.tasks}}" wx:key="planId"><view class="value">{{item.name}}</view><view class="task-status">{{item.completed ? '已完成' : '未完成'}}</view></view>
    <view class="empty compact" wx:if="{{!selectedDay.tasks.length}}">当天没有向你公开的计划任务</view>
  </view>
  <view class="privacy-note">好友为弱监督关系：这里只展示对方允许查看的打卡，不包含心情、备注、小记或其他个人记录。</view>
</view>

<view wx:if="{{settingsVisible}}" class="sheet-mask" bindtap="closeSettings">
  <view class="settings-sheet" catchtap="noop">
    <view class="sheet-handle"></view><view class="row"><view class="h2">好友设置</view><view class="sheet-close" bindtap="closeSettings">×</view></view>
    <view class="field"><view class="label">备注名（仅自己可见）</view><input class="input" maxlength="30" value="{{settings.remark}}" bindinput="remarkInput" placeholder="给好友添加备注"/></view>
    <view class="setting-block"><view class="row"><view><view class="value">特别关心</view><view class="sub">在圈子查看对方允许公开的打卡</view></view><switch checked="{{settings.specialCare}}" bindchange="specialChange" color="#222222"/></view><view wx:if="{{settings.specialCare}}" class="row nested-setting"><view><view class="value">{{isLongTerm ? '长期微信提醒' : '微信提醒'}}</view><view class="sub">{{isLongTerm ? '对方每次公开打卡时尝试提醒' : '订阅对方下一次打卡提醒'}}</view></view><switch checked="{{settings.specialCareWechat}}" bindchange="specialWechatChange" color="#222222"/></view></view>
    <view class="setting-block"><view class="row"><view><view class="value">单独设置向 TA 公开的内容</view><view class="sub">关闭时跟随“我的”中的统一隐私设置</view></view><switch checked="{{settings.privacyMode === 'CUSTOM'}}" bindchange="privacyModeChange" color="#222222"/></view><view wx:if="{{settings.privacyMode === 'CUSTOM'}}" class="privacy-list"><view class="row privacy-row" wx:for="{{privacyFields}}" wx:key="key"><view>{{item.label}}</view><switch checked="{{item.checked}}" data-key="{{item.key}}" bindchange="privacyChange" color="#222222"/></view></view></view>
    <button class="btn" loading="{{saving}}" bindtap="saveSettings">保存备注与隐私</button>
    <button class="btn btn-danger remove-button" bindtap="removeFriend">删除好友</button>
  </view>
</view>
