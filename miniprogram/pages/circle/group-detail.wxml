<view class="container" wx:if="{{group}}">
  <view class="hero"><view class="h1">{{group.displayName || group.name}}</view><view class="sub" wx:if="{{group.remark}}">群名称：{{group.name}}</view><view class="sub">{{group.description || '一起执行，彼此监督。'}}</view></view>

  <view class="card partner-card">
    <view class="list-item row member-row {{item.completedAll ? 'member-complete' : ''}} {{item.progressState === 'NO_PLAN' ? 'member-no-plan' : ''}}" wx:for="{{members}}" wx:key="_id" data-id="{{item._id}}" bindtap="openMember"><view class="row-start"><image wx:if="{{item.avatar}}" class="member-avatar" src="{{item.avatar}}" mode="aspectFill"/><view wx:else class="member-avatar fallback">{{item.initial}}</view><view><view class="value">{{item.nickname}}</view><view class="owner-label" wx:if="{{item.role === 'OWNER'}}">群主</view></view></view><view class="row-start"><view class="progress-text" wx:if="{{item.total}}">{{item.completed}} / {{item.total}}</view><view class="sub" wx:else>暂无绑定计划</view><button wx:if="{{isOwner && item.role !== 'OWNER'}}" class="kick-button" data-id="{{item._id}}" data-name="{{item.nickname}}" catchtap="kickMember">移出</button><view class="member-arrow">›</view></view></view>
  </view>

  <view class="card" wx:if="{{isOwner && pendingRequests.length}}">
    <view class="h2">入群申请</view>
    <view class="list-item row" wx:for="{{pendingRequests}}" wx:key="membershipId"><view class="row-start"><image wx:if="{{item.user.avatar}}" class="member-avatar" src="{{item.user.avatar}}" mode="aspectFill"/><view wx:else class="member-avatar fallback">{{item.user.initial}}</view><view class="value">{{item.user.nickname}}</view></view><view class="request-actions"><button class="btn btn-light btn-small" data-id="{{item.membershipId}}" data-approve="false" bindtap="reviewJoin">拒绝</button><button class="btn btn-small" data-id="{{item.membershipId}}" data-approve="true" bindtap="reviewJoin">同意</button></view></view>
  </view>

  <view class="card" wx:if="{{isOwner && pendingPlanChanges.length}}">
    <view class="h2">计划变更申请</view>
    <view class="list-item" wx:for="{{pendingPlanChanges}}" wx:key="_id"><view class="value">{{item.applicant.nickname}}：{{item.summary}}</view><view class="sub">{{item.detail}}</view><view class="request-actions plan-review-actions"><button class="btn btn-light btn-small" data-id="{{item._id}}" data-approve="false" bindtap="reviewPlanChange">拒绝</button><button class="btn btn-small" data-id="{{item._id}}" data-approve="true" bindtap="reviewPlanChange">同意</button></view></view>
  </view>

  <view class="card" wx:if="{{isOwner && permissions}}">
    <view class="h2">群权限</view>
    <view class="setting-row row"><view><view class="value">进群需要审批</view><view class="sub">成员输入群 ID 后由群主确认</view></view><switch checked="{{permissions.joinApprovalRequired}}" disabled="{{savingPermissions}}" data-key="joinApprovalRequired" bindchange="permissionSwitch" color="#222222"/></view>
    <view class="setting-row row"><view><view class="value">连续未打卡自动移出</view><view class="sub">群主不会被自动移出</view></view><switch checked="{{permissions.autoRemoveInactiveDays > 0}}" disabled="{{savingPermissions}}" bindchange="autoRemoveSwitch" color="#222222"/></view>
    <view class="field inactive-days" wx:if="{{permissions.autoRemoveInactiveDays > 0}}"><view class="label">连续未打卡天数（1-365）</view><input class="input" type="number" value="{{permissions.autoRemoveInactiveDays}}" bindinput="autoRemoveDaysInput" bindblur="autoRemoveDaysChange"/></view>
    <view class="setting-row row" wx:if="{{permissions.autoRemoveInactiveDays > 0}}"><view><view class="value">被自动移出后禁止再次加入</view><view class="sub">关闭后仍可重新申请或加入</view></view><switch checked="{{permissions.blockRejoinAfterAutoRemove}}" disabled="{{savingPermissions}}" data-key="blockRejoinAfterAutoRemove" bindchange="permissionSwitch" color="#222222"/></view>
  </view>

  <view class="card event-card">
    <view class="row event-toggle" bindtap="toggleEvents"><view><view class="h2">打卡动态</view><view class="sub">{{events.length ? events.length + ' 条记录 · 默认折叠' : '暂无打卡动态'}}</view></view><view class="event-chevron">{{eventsExpanded ? '⌃' : '⌄'}}</view></view>
    <view wx:if="{{eventsExpanded}}" class="event-list">
      <view class="list-item event-item {{item.status === 'REVOKED' ? 'event-revoked' : ''}}" wx:for="{{events}}" wx:key="_id"><view class="value">{{item.title}}</view><view class="row event-meta"><view><view class="sub">{{item.summary}}</view><view class="event-time">{{item.displayTime}}</view></view><button wx:if="{{item.eventType === 'PLAN_COMPLETED' && item.status !== 'REVOKED'}}" class="like-button {{item.likedByMe ? 'liked' : ''}}" data-index="{{index}}" catchtap="toggleLike">{{item.likedByMe ? '♥' : '♡'}} {{item.likeCount || ''}}</button></view></view>
      <view class="empty compact" wx:if="{{!events.length}}">完成绑定计划后，记录会显示在这里</view>
    </view>
  </view>
  <button wx:if="{{isOwner}}" class="btn btn-danger disband-button" loading="{{disbanding}}" disabled="{{disbanding}}" bindtap="disband">解散群聊</button>
  <button wx:if="{{!isOwner}}" class="btn btn-danger" bindtap="leave">退出群组</button>
</view>
