<active-timer id="activeTimerBar"/>
<view class="container">
  <view class="hero"><view class="h1">好友与群组</view><view class="sub">用轻量提醒和点赞，一起坚持下去</view></view>
  <view class="card" data-url="/pages/circle/friends" bindtap="go"><view class="row"><view class="row-start"><view class="circle-icon-wrap"><image class="circle-icon" src="/assets/categories/friends.png" mode="aspectFit"/><view wx:if="{{pendingFriendRequestCount}}" class="circle-red-dot"></view></view><view><view class="h2">好友 <text wx:if="{{pendingFriendRequestCount}}" class="pending-text">{{pendingFriendRequestCount}} 条申请</text></view><view class="sub">查看好友打卡并管理特别关心</view></view></view><view>›</view></view></view>
  <view class="card" data-url="/pages/circle/groups" bindtap="go"><view class="row"><view class="row-start"><image class="circle-icon" src="/assets/categories/groups.png" mode="aspectFit"/><view><view class="h2">群组</view><view class="sub">只广播打卡动态，不设置群聊</view></view></view><view>›</view></view></view>
  <view class="section-title">今日 · 特别关心动态</view>
  <view class="card"><view class="list-item care-event" wx:for="{{feed}}" wx:key="_id" data-id="{{item.actorUserId}}" bindtap="openFriend"><view class="row"><view class="value">{{item.nickname}} 完成了「{{item.planName}}」</view><view class="sub">{{item.displayTime}}</view></view></view><view class="empty compact" wx:if="{{loading && !feed.length}}">正在加载…</view><view class="empty compact" wx:elif="{{!feed.length}}">今天还没有特别关心好友的打卡</view></view>
</view>
