.circle-icon { width:64rpx; height:64rpx; flex:0 0 64rpx; image-rendering:pixelated; }
.circle-icon-wrap { position:relative; width:64rpx; height:64rpx; flex:0 0 64rpx; }
.circle-red-dot { position:absolute; top:-4rpx; right:-4rpx; width:16rpx; height:16rpx; border:4rpx solid #fff; border-radius:50%; background:#e5484d; }
.pending-text { margin-left:8rpx; color:#e5484d; font-size:22rpx; font-weight:500; }
.care-event .value { font-size: 28rpx; }
.care-event .sub { flex: 0 0 auto; margin-left: 20rpx; }
