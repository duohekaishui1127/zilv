.retry-btn { margin-top: 20rpx; }
.message-entry { position: relative; width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; color: #a0a6af; border-radius: 18rpx; background: #eef0f3; }
.message-entry-unread { color: #303846; background: #fff; box-shadow: 0 4rpx 16rpx rgba(17,24,39,.08); }
.message-envelope { position: relative; width: 34rpx; height: 25rpx; box-sizing: border-box; border: 4rpx solid currentColor; border-radius: 4rpx; }
.message-envelope::after { content: ''; position: absolute; left: 5rpx; top: -2rpx; width: 17rpx; height: 17rpx; box-sizing: border-box; border-left: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(-45deg); }
.message-red-dot { position: absolute; top: 8rpx; right: 8rpx; width: 16rpx; height: 16rpx; border: 4rpx solid #fff; border-radius: 50%; background: #e5484d; }
.card-toggle { min-height: 52rpx; }
.compact-row { gap: 12rpx; }
.chevron { color: #8a8f98; font-size: 30rpx; min-width: 30rpx; text-align: center; }
.plan-list { margin-top: 10rpx; }
.plan-item { padding: 24rpx 0; border-bottom: 1rpx solid #eef0f2; }
.plan-item:last-of-type { border-bottom: 0; }
.check-circle { width: 42rpx; height: 42rpx; flex: 0 0 42rpx; border: 3rpx solid #9ca3af; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 25rpx; font-weight: 700; }
.check-circle-done { border-color: #697386; background: #697386; }
.plan-item-completed { opacity: .62; }
.plan-item-completed .plan-name, .plan-item-completed .plan-description { color: #9ca3af; }
.completion-meta { margin-top: 9rpx; color: #7b8492; font-size: 23rpx; line-height: 1.5; }
.inline-mood-icon { width: 30rpx; height: 30rpx; margin-left: 8rpx; vertical-align: -7rpx; image-rendering: pixelated; }
.timer-panel { margin-top: 18rpx; padding: 18rpx; border-radius: 18rpx; background: #f7f8fa; }
.timer-head { align-items: baseline; }
.timer-state { color: #697386; font-size: 23rpx; }
.timer-clock { color: #111827; font-size: 38rpx; font-weight: 700; letter-spacing: 2rpx; font-variant-numeric: tabular-nums; }
.timer-summary { margin-top: 8rpx; color: #8a8f98; font-size: 22rpx; }
.timer-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.timer-actions .btn { min-width: 126rpx; }
.timer-primary { background: #111827; color: #fff; }
.plan-tip { padding-top: 18rpx; }
.streak-row { display:flex; justify-content:space-between; gap:16rpx; margin-top:16rpx; color:#303846; font-size:23rpx; font-weight:600; }
.streak-action { flex:0 0 auto; color:#697386; font-weight:400; }
.auto-checkin-hint { margin-top:14rpx; text-align:right; }
.energy-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-top: 22rpx; }
.energy-metric { min-width: 0; background: #f8f9fb; border-radius: 18rpx; padding: 20rpx 10rpx; text-align: center; }
.energy-value { margin: 5rpx 0; font-size: 34rpx; font-weight: 700; overflow-wrap: anywhere; }
.energy-details { margin-top: 6rpx; }
.detail-row { display: flex; justify-content: space-between; gap: 20rpx; padding: 10rpx 0; }
.nutrition-title { margin-top: 28rpx; }
.food-entry-button { margin: 24rpx 0 18rpx; }

.sheet-mask { position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-end; background: rgba(17, 24, 39, .42); }
.completion-sheet { width: 100%; max-height: 88vh; overflow-y: auto; box-sizing: border-box; padding: 18rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); background: #fff; border-radius: 30rpx 30rpx 0 0; }
.sheet-handle { width: 72rpx; height: 8rpx; border-radius: 999rpx; background: #d6dae0; margin: 0 auto 24rpx; }
.sheet-close { padding: 12rpx; color: #8a8f98; font-size: 42rpx; line-height: 1; }
.completion-field { margin-top: 30rpx; }
.timer-result { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin: 30rpx 0 24rpx; }
.timer-result-item { min-width: 0; padding: 18rpx 10rpx; border-radius: 16rpx; background: #f5f6f8; text-align: center; }
.timer-result-item .value { margin-top: 8rpx; font-size: 27rpx; font-variant-numeric: tabular-nums; }
.mood-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.mood-chip { display:flex; align-items:center; gap:8rpx; padding: 10rpx 16rpx; border-radius: 999rpx; color: #60646c; background: #f0f2f5; font-size: 24rpx; }
.mood-chip-active { color: #fff; background: #303846; }
.mood-picker-icon { width: 34rpx; height: 34rpx; image-rendering: pixelated; }
.note-input { min-height: 150rpx; }
