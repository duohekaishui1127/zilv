<view class="container">
  <view wx:if="{{loading && !dashboard}}" class="empty">正在加载今日数据…</view>
  <view wx:elif="{{error && !dashboard}}" class="card error-card">
    <view class="value">今日数据加载失败</view>
    <view class="sub">{{error}}</view>
    <button class="btn btn-small retry-btn" bindtap="retry">重新加载</button>
  </view>

  <block wx:elif="{{dashboard}}">
    <view class="hero row">
      <view><view class="h1">自律</view><view class="sub">{{dashboard.user.nickname}} · 今日事今日毕</view></view>
      <view class="tag" bindtap="goNotifications">消息{{dashboard.unreadNotificationCount ? ' ' + dashboard.unreadNotificationCount : ''}}</view>
    </view>

    <view class="card plan-card">
      <view class="row card-toggle" bindtap="togglePlans">
        <view class="h2">今日计划</view>
        <view class="row compact-row"><view class="big">{{dashboard.completion.completed}}/{{dashboard.completion.total}}</view><view class="chevron">{{plansExpanded ? '⌃' : '⌄'}}</view></view>
      </view>
      <view class="progress"><view class="progress-inner" style="width: {{completionPct}}%;"></view></view>

      <view wx:if="{{plansExpanded}}" class="plan-list">
        <view class="plan-item {{item.completed ? 'plan-item-completed' : ''}}" wx:for="{{dashboard.plans}}" wx:key="_id" data-index="{{index}}" bindtap="openCompletion">
          <view class="row-start">
            <view class="flex-1">
              <view class="value plan-name">{{item.name}}</view>
              <view class="sub plan-description" wx:if="{{item.description}}">{{item.description}}</view>
              <view class="sub" wx:if="{{item.repeatType === 'WEEKLY_COUNT'}}">{{item.categoryLabel}} · 本周 {{item.weeklyProgress.completed}}/{{item.weeklyProgress.target}} · 每次 {{item.targetValue}}{{item.unit}}</view>
              <view class="sub" wx:else>{{item.categoryLabel}} · 目标 {{item.targetValue}}{{item.unit}}</view>
              <view class="timer-panel" wx:if="{{item.timerEnabled && !item.completed}}" catchtap="noop">
                <view class="row timer-head"><view class="timer-state">{{item.timerModeLabel}} · {{item.timerStatusLabel}}</view><view class="timer-clock">{{item.timerDisplay}}</view></view>
                <view class="timer-summary" wx:if="{{item.timerStatus}}">有效 {{item.timerEffectiveDisplay}} · 总用时 {{item.timerTotalDisplay}} · 暂停 {{item.timerPausedDisplay}}</view>
                <view class="timer-actions">
                  <button wx:if="{{!item.timerStatus}}" class="btn btn-small timer-primary" data-index="{{index}}" loading="{{timerBusyPlanId === item._id}}" catchtap="startTimer">开始</button>
                  <button wx:elif="{{item.timerStatus === 'RUNNING'}}" class="btn btn-small btn-light" data-index="{{index}}" loading="{{timerBusyPlanId === item._id}}" catchtap="pauseTimer">暂停</button>
                  <button wx:elif="{{item.timerStatus === 'PAUSED'}}" class="btn btn-small timer-primary" data-index="{{index}}" loading="{{timerBusyPlanId === item._id}}" catchtap="resumeTimer">继续</button>
                  <button wx:if="{{item.timerStatus === 'RUNNING' || item.timerStatus === 'PAUSED'}}" class="btn btn-small btn-danger" data-index="{{index}}" catchtap="finishTimer">结束</button>
                  <button wx:if="{{item.timerStatus === 'FINISHED'}}" class="btn btn-small timer-primary" data-index="{{index}}" catchtap="quickComplete">完成</button>
                </view>
              </view>
              <view class="completion-meta" wx:if="{{item.completed && (item.checkin.durationMinutes || item.checkin.note || item.checkin.timerStatus)}}">
                <text wx:if="{{item.checkin.timerStatus}}">有效 {{item.timerEffectiveDisplay}} · 总用时 {{item.timerTotalDisplay}} · 暂停 {{item.timerPausedDisplay}}</text>
                <text wx:elif="{{item.checkin.durationMinutes}}">用时 {{item.checkin.durationMinutes}} 分钟</text>
                <text wx:if="{{item.checkin.note}}">{{item.checkin.timerStatus || item.checkin.durationMinutes ? ' · ' : ''}}{{item.checkin.note}}</text>
              </view>
            </view>
            <view class="check-circle {{item.completed ? 'check-circle-done' : ''}}" data-index="{{index}}" catchtap="quickComplete">{{item.completed ? '✓' : ''}}</view>
          </view>
        </view>
        <view wx:if="{{!dashboard.plans.length}}" class="empty compact">今天还没有待执行计划</view>
        <view class="sub plan-tip" wx:if="{{dashboard.plans.length}}">点圆圈直接完成；完成后点任务可补充备注。计划内容与群组关联请到“计划”页修改。</view>
      </view>
    </view>

    <view class="card daily-checkin-card {{dashboard.dailyReview || dashboard.completion.completed === dashboard.completion.total ? '' : 'daily-checkin-disabled'}}" bindtap="openDailyReview">
      <view class="row">
        <view class="row-start">
          <image wx:if="{{dashboard.dailyReview && dashboard.dailyReview.moodIcon}}" class="daily-mood-icon" src="{{dashboard.dailyReview.moodIcon}}" mode="aspectFit"/>
          <view>
            <view class="h2">{{dashboard.dailyReview ? '今日已打卡' : '完成今日打卡'}}</view>
            <view class="sub" wx:if="{{dashboard.dailyReview}}">{{dashboard.dailyReview.moodLabel}}{{dashboard.dailyReview.note ? ' · ' + dashboard.dailyReview.note : ''}}</view>
            <view class="sub" wx:elif="{{dashboard.completion.completed === dashboard.completion.total}}">记录整日心情和一句小记</view>
            <view class="sub" wx:else>完成全部计划后即可打卡</view>
          </view>
        </view>
        <view>›</view>
      </view>
    </view>

    <view class="card energy-card" wx:if="{{dashboard.homePreferences.showEnergy}}">
      <view class="row card-toggle" bindtap="toggleEnergy">
        <view class="h2">今日能量</view><view class="chevron">{{energyExpanded ? '⌃' : '⌄'}}</view>
      </view>
      <view class="energy-summary">
        <view class="energy-metric"><view class="label">摄入</view><view class="energy-value">{{dashboard.nutrition.calorieIntake}}</view><view class="label">kcal</view></view>
        <view class="energy-metric"><view class="label">基础代谢</view><view class="energy-value">{{dashboard.nutritionTarget ? dashboard.nutritionTarget.bmr : '--'}}</view><view class="label">kcal</view></view>
        <view class="energy-metric" wx:if="{{energyState.isDeficit}}"><view class="label">热量缺口</view><view class="energy-value success">{{energyState.deficit}}</view><view class="label">kcal</view></view>
        <view class="energy-metric" wx:elif="{{energyState.isSurplus}}"><view class="label">热量盈余</view><view class="energy-value danger">{{energyState.surplus}}</view><view class="label">kcal</view></view>
        <view class="energy-metric" wx:else><view class="label">热量平衡</view><view class="energy-value">0</view><view class="label">kcal</view></view>
      </view>

      <view wx:if="{{energyExpanded}}" class="energy-details">
        <view class="divider"></view>
        <view class="detail-row"><text class="label">基础生活消耗</text><text>{{dashboard.energy.baseDailyExpenditure}} kcal</text></view>
        <view class="detail-row"><text class="label">运动消耗</text><text>{{dashboard.energy.exerciseExpenditure}} kcal</text></view>
        <view class="detail-row"><text class="label">预计总消耗</text><text>{{dashboard.energy.estimatedTotalExpenditure}} kcal</text></view>

        <block wx:if="{{dashboard.nutritionTarget}}">
          <view class="section-title nutrition-title">营养目标</view>
          <view class="list-item"><view class="row"><text>蛋白质</text><text>{{dashboard.nutrition.proteinIntake}} / {{dashboard.nutritionTarget.proteinGram}}g</text></view><view class="progress"><view class="progress-inner" style="width:{{proteinPct}}%"></view></view></view>
          <view class="list-item"><view class="row"><text>碳水</text><text>{{dashboard.nutrition.carbIntake}} / {{dashboard.nutritionTarget.carbGram}}g</text></view><view class="progress"><view class="progress-inner" style="width:{{carbPct}}%"></view></view></view>
          <view class="list-item"><view class="row"><text>脂肪</text><text>{{dashboard.nutrition.fatIntake}} / {{dashboard.nutritionTarget.fatGram}}g</text></view><view class="progress"><view class="progress-inner" style="width:{{fatPct}}%"></view></view></view>
        </block>
        <view wx:else class="tip">营养目标尚未生成。请先在“我的 → 身体与营养档案”完善资料，并至少记录一次体重。</view>
        <button class="btn btn-light food-entry-button" bindtap="goFood">添加 / 查看今日进食</button>
        <view class="sub">热量缺口按预计总消耗计算；所有消耗均为模型估算值。</view>
      </view>
    </view>
  </block>
</view>

<view wx:if="{{completionEditor.visible}}" class="sheet-mask" bindtap="closeCompletion">
  <view class="completion-sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="row"><view><view class="h2">任务备注</view><view class="sub">{{completionEditor.planName}}</view></view><view class="sheet-close" bindtap="closeCompletion">×</view></view>

    <view class="timer-result" wx:if="{{completionEditor.timed}}">
      <view class="timer-result-item"><view class="label">有效时间</view><view class="value">{{completionEditor.timerEffectiveDisplay}}</view></view>
      <view class="timer-result-item"><view class="label">总用时</view><view class="value">{{completionEditor.timerTotalDisplay}}</view></view>
      <view class="timer-result-item"><view class="label">暂停时间</view><view class="value">{{completionEditor.timerPausedDisplay}}</view></view>
    </view>
    <view class="field">
      <view class="label">备注（可选）</view>
      <textarea class="input note-input" maxlength="500" data-key="note" value="{{completionEditor.note}}" bindinput="editorInput" placeholder="补充这项任务的过程或结果"/>
    </view>
    <button class="btn" loading="{{completionSaving}}" bindtap="saveCompletion">保存备注</button>
  </view>
</view>

<view wx:if="{{dailyReviewEditor.visible}}" class="sheet-mask" bindtap="closeDailyReview">
  <view class="completion-sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="row"><view><view class="h2">今日打卡</view><view class="sub">为完整的一天留下心情和小记</view></view><view class="sheet-close" bindtap="closeDailyReview">×</view></view>
    <view class="field completion-field">
      <view class="label">今天整体感觉如何？</view>
      <view class="mood-row">
        <view wx:for="{{moods}}" wx:key="value" class="mood-chip {{dailyReviewEditor.mood === item.value ? 'mood-chip-active' : ''}}" data-value="{{item.value}}" bindtap="chooseDailyMood"><image class="mood-picker-icon" src="{{item.icon}}" mode="aspectFit"/><text>{{item.label}}</text></view>
      </view>
    </view>
    <view class="field"><view class="label">今日小记（可选）</view><textarea class="input note-input" maxlength="1000" value="{{dailyReviewEditor.note}}" bindinput="dailyReviewInput" placeholder="写下今天值得记住的一句话"/></view>
    <button class="btn" loading="{{completionSaving}}" bindtap="saveDailyReview">保存今日打卡</button>
  </view>
</view>
