.data-page{background:#f4f6f5}.pixel-kicker{font:800 20rpx monospace;letter-spacing:4rpx;color:#315f4a}.summary-card{border:2rpx solid #111827;border-radius:9rpx;box-shadow:6rpx 6rpx 0 rgba(17,24,39,.08)}.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}.summary-grid>view{padding:18rpx;border:1rpx solid #e5e7eb;background:#f8faf9}.summary-grid text{display:block;font:900 38rpx monospace;color:#244b38}.summary-grid view view{margin-top:6rpx;color:#8a8f98;font-size:21rpx}.data-action{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:22rpx 0;border-bottom:1rpx solid #eef0f2}.data-action:last-child{border-bottom:0}.danger-zone{border:2rpx solid #efc7c4}.danger-title{margin-bottom:6rpx;color:#b42318;font:800 18rpx monospace;letter-spacing:3rpx}.confirm-mask{position:fixed;inset:0;z-index:100;display:flex;align-items:flex-end;padding:28rpx;box-sizing:border-box;background:rgba(17,24,39,.52)}.confirm-box{width:100%;padding:30rpx;border:2rpx solid #111827;border-radius:10rpx;background:#fff;box-shadow:8rpx 8rpx 0 rgba(0,0,0,.18)}.confirm-title{margin-top:14rpx;font-size:36rpx;font-weight:900;color:#111827}.confirm-desc{margin-top:12rpx;color:#6b7280;font-size:24rpx;line-height:1.65}.confirm-hint{margin-top:24rpx;color:#374151;font-size:23rpx;font-weight:700}.confirm-actions{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:20rpx}.confirm-actions .btn{width:100%}
