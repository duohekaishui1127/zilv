.consent-page{min-height:100vh;padding:44rpx 30rpx 80rpx;box-sizing:border-box;background:#eef2ef}.consent-shell{max-width:720rpx;margin:0 auto}.pixel-kicker{font:800 20rpx monospace;letter-spacing:4rpx;color:#315f4a}.consent-title{margin-top:20rpx;font-size:52rpx;line-height:1.22;font-weight:900;color:#111827}.consent-copy{margin-top:18rpx;color:#6b7280;font-size:27rpx;line-height:1.7}.consent-card{margin-top:34rpx;border:2rpx solid #111827;border-radius:10rpx;background:#fff;box-shadow:7rpx 7rpx 0 rgba(17,24,39,.1)}.consent-row{display:flex;align-items:center;justify-content:space-between;padding:25rpx 24rpx;border-bottom:1rpx solid #e5e7eb}.consent-row:last-child{border-bottom:0}.consent-label{font-weight:800;color:#111827}.consent-meta{margin-top:6rpx;font:20rpx monospace;color:#8a8f98}.privacy-points{margin:28rpx 0}.point{display:flex;gap:20rpx;margin:18rpx 0}.point>text{flex:0 0 auto;width:54rpx;height:54rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid #315f4a;background:#dceee4;color:#244b38;font:900 18rpx monospace}.point-title{font-weight:800;color:#111827}.point-copy{margin-top:5rpx;color:#6b7280;font-size:23rpx;line-height:1.6}.check-line{display:flex;align-items:flex-start;gap:14rpx;padding:18rpx 0;color:#4b5563;font-size:23rpx;line-height:1.6}.check-line text{color:#244b38;font-weight:700}.pixel-check{flex:0 0 auto;width:34rpx;height:34rpx;border:2rpx solid #111827;background:#fff;text-align:center;line-height:32rpx;font-weight:900}.checked .pixel-check{background:#315f4a;color:#fff;border-color:#315f4a}.primary,.ghost{width:100%;margin-top:18rpx;border-radius:8rpx}.primary{background:#111827;color:#fff;font-weight:800}.ghost{background:#fff;color:#6b7280;border:2rpx solid #d1d5db}.primary::after,.ghost::after{border:0}.production-warning{margin-top:24rpx;padding:18rpx;border:2rpx dashed #b45309;background:#fff7ed;color:#92400e;font-size:21rpx;line-height:1.6}
