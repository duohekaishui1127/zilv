<view class="container">
  <view class="hero"><view class="h1">任务</view><view class="sub">长期目标指引方向，执行任务负责每天行动</view></view>

  <view class="section-head row"><view><view class="h2">长期目标</view><view class="sub">仅自己可见，不参与好友和群组监督</view></view><view class="tag goal-tag">{{goals.length}} 个进行中</view></view>
  <view class="card goal-card" wx:for="{{goals}}" wx:key="_id">
    <view class="row">
      <view class="flex-1"><view class="value">{{item.name}}</view><view class="sub">{{item.goalTypeLabel}} · {{item.progressText}}</view><view class="sub">已关联 {{item.linkedPlanCount}} 个执行任务{{item.todayProgress.total ? ' · 今日 ' + item.todayProgress.completed + '/' + item.todayProgress.total : ''}}</view></view>
      <view class="goal-status" wx:if="{{item.hasProgressBar}}">{{item.progressPct || 0}}%</view>
    </view>
    <view class="progress goal-progress" wx:if="{{item.hasProgressBar}}"><view class="progress-inner" style="width:{{item.progressPct}}%"></view></view>
    <view class="action-row">
      <button class="btn btn-light btn-small" data-id="{{item._id}}" bindtap="editGoal">编辑</button>
      <button class="btn btn-light btn-small" data-id="{{item._id}}" bindtap="finishGoal">完成</button>
      <button class="btn btn-danger btn-small" data-id="{{item._id}}" bindtap="removeGoal">删除</button>
    </view>
  </view>
  <view class="card empty compact" wx:if="{{!goals.length}}">还没有长期目标，点击右下角创建</view>

  <view class="section-head execution-head"><view class="h2">执行任务</view><view class="sub">按日期和时间出现在“今日”，可以打卡并绑定目标或群组</view></view>
  <view class="card">
    <view class="list-item" wx:for="{{plans}}" wx:key="_id">
      <view class="row">
        <view class="flex-1"><view class="value {{item.enabled ? '' : 'muted'}}">{{item.name}}</view><view class="sub" wx:if="{{item.description}}">{{item.description}}</view><view class="sub">{{item.executionTime ? item.executionTime + ' · ' : ''}}{{item.categoryLabel}} · {{item.scheduleLabel}} · {{item.targetValue}}{{item.unit}}</view><view class="sub" wx:if="{{item.goalBindingCount}}">已关联 {{item.goalBindingCount}} 个长期目标</view><view class="sub" wx:if="{{item.timerMode && item.timerMode !== 'NONE'}}">{{item.timerLabel}}{{item.timerMode === 'COUNT_DOWN' ? ' · ' + item.timerDurationMinutes + '分钟' : ''}}</view></view>
        <view class="tag">{{item.enabled ? '启用' : '停用'}}</view>
      </view>
      <view class="action-row">
        <button class="btn btn-light btn-small" data-id="{{item._id}}" bindtap="edit">编辑</button>
        <button class="btn btn-light btn-small" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="bindGroup">绑定</button>
        <button class="btn btn-light btn-small" data-id="{{item._id}}" data-enabled="{{item.enabled}}" bindtap="toggle">{{item.enabled ? '停用' : '启用'}}</button>
        <button class="btn btn-danger btn-small" data-id="{{item._id}}" bindtap="remove">删除</button>
      </view>
    </view>
    <view class="empty compact" wx:if="{{!plans.length}}">还没有执行任务</view>
  </view>

  <view wx:if="{{achievedGoals.length}}" class="achieved-section">
    <view class="section-head"><view class="h2">我的进步之路</view><view class="sub">已达成的目标和养成的习惯会保留在这里</view></view>
    <view class="card achieved-card"><view class="list-item row" wx:for="{{achievedGoals}}" wx:key="_id"><view><view class="value">{{item.name}}</view><view class="sub">{{item.goalTypeLabel}} · {{item.progressText}}</view></view><view class="success">✓</view></view></view>
  </view>
  <view class="fab" bindtap="add">+</view>
</view>
