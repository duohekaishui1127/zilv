<view class="container">
  <view class="empty" wx:if="{{loading}}">正在加载长期目标…</view>
  <view class="card" wx:else>
    <view class="field"><view class="label">目标类型</view><view class="goal-types"><view wx:for="{{goalTypes}}" wx:key="value" class="goal-type {{goalType === item.value ? 'goal-type-active' : ''}} {{editMode ? 'goal-type-locked' : ''}}" data-value="{{item.value}}" bindtap="chooseType">{{item.label}}</view></view><view class="sub" wx:if="{{editMode}}">目标类型创建后不可更改</view></view>
    <view class="field"><view class="label">目标名称</view><input class="input" data-key="name" value="{{name}}" bindinput="input" placeholder="例如：英语六级"/></view>
    <view class="field" wx:if="{{goalType === 'DEADLINE'}}"><view class="label">考试日期</view><picker mode="date" value="{{deadlineDate}}" bindchange="dateChange"><view class="input">{{deadlineDate}}</view></picker><view class="sub">显示倒计时并在固定节点提醒；考试日自动结束备考并归档，不会产生逾期。</view></view>
    <view class="field" wx:if="{{goalType === 'HABIT'}}"><view class="label">连续打卡天数</view><input class="input" type="number" data-key="habitDays" value="{{habitDays}}" bindinput="input"/><view class="sub">默认连续21天，达成后自动提醒并归档为已养成。</view></view>
    <block wx:if="{{goalType === 'ACCUMULATION'}}">
      <view class="list-item row"><view><view class="value">持续积累，不设上限</view><view class="sub">开启后只汇总累计成果，由你决定何时结束</view></view><switch checked="{{unlimited}}" bindchange="toggleUnlimited"/></view>
      <view class="row" wx:if="{{!unlimited}}"><view class="field flex-1"><view class="label">总目标</view><input class="input" type="digit" data-key="targetValue" value="{{targetValue}}" bindinput="input"/></view><view class="field flex-1"><view class="label">单位</view><input class="input" data-key="unit" value="{{unit}}" bindinput="input" placeholder="词/页/公里"/></view></view>
      <view class="field" wx:else><view class="label">累计单位</view><input class="input" data-key="unit" value="{{unit}}" bindinput="input" placeholder="词/页/公里"/></view>
      <view class="field" wx:if="{{!unlimited}}"><view class="label">计划完成日期</view><picker mode="date" value="{{accumulationDeadlineDate}}" bindchange="accumulationDateChange"><view class="input">{{accumulationDeadlineDate}}</view></picker><view class="sub">系统会根据剩余数量和剩余执行次数，自动调整每次目标。</view></view>
      <view class="divider"></view>
      <view class="h2 managed-title">配套执行任务</view>
      <view class="sub managed-description">{{editMode ? '执行频率和时间请在任务列表中编辑；建议量会自动重新计算。' : '保存后自动创建，不需要再手动绑定，也不能与长期目标分开删除。'}}</view>
      <view class="field" wx:if="{{editMode && unlimited}}"><view class="label">每次默认累计量</view><view class="row"><input class="input flex-1" type="digit" data-key="executionTargetValue" value="{{executionTargetValue}}" bindinput="input"/><view class="managed-unit">{{unit}}</view></view></view>
      <block wx:if="{{!editMode}}">
      <view class="field"><view class="label">任务分类</view><picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="category"><view class="input">{{categories[categoryIndex]}}</view></picker></view>
      <view class="field"><view class="label">执行频率</view><picker mode="selector" range="{{repeatTypes}}" value="{{repeatIndex}}" bindchange="repeat"><view class="input">{{repeatTypes[repeatIndex]}}</view></picker></view>
      <view wx:if="{{isSpecificDays}}" class="field"><view class="label">选择星期</view><view class="row wrap managed-weekdays"><view wx:for="{{weekdays}}" wx:key="value" data-day="{{item.value}}" bindtap="toggleDay" class="tag {{item.selected ? 'tag-active' : ''}}">{{item.selected ? '✓ ' : ''}}周{{item.label}}</view></view></view>
      <view wx:if="{{isWeeklyCount}}" class="field"><view class="label">每周完成次数</view><input class="input" type="number" data-key="weeklyCount" value="{{weeklyCount}}" bindinput="input"/></view>
      <view class="field" wx:if="{{unlimited}}"><view class="label">每次默认累计量</view><view class="row"><input class="input flex-1" type="digit" data-key="executionTargetValue" value="{{executionTargetValue}}" bindinput="input"/><view class="managed-unit">{{unit}}</view></view><view class="sub">打卡时自动填入，实际数量不同时再修改。</view></view>
      <view class="list-item row"><view><view class="value">指定执行时间</view><view class="sub">不指定则作为全天任务显示</view></view><switch checked="{{hasExecutionTime}}" bindchange="toggleExecutionTime"/></view>
      <view wx:if="{{hasExecutionTime}}" class="field"><view class="label">执行时间</view><picker mode="time" value="{{executionTime}}" bindchange="timeChange"><view class="input">{{executionTime}}</view></picker></view>
      </block>
    </block>
    <view class="field"><view class="label">备注（可选）</view><textarea class="input" data-key="description" value="{{description}}" bindinput="input" maxlength="300" placeholder="写一句目标说明即可"/></view>
    <view class="tip" wx:if="{{goalType === 'ACCUMULATION'}}">系统会自动管理配套任务；长期目标结束或达成后，任务会同时收起，历史记录保留在“我的进步”。</view>
    <view class="tip" wx:else>创建后，可在普通执行任务的“绑定”中选择这个目标。长期目标默认完全私密。</view>
    <button class="btn" loading="{{saving}}" bindtap="save">{{editMode ? '保存修改' : '创建长期目标'}}</button>
  </view>
</view>
