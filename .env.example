# 仅作为部署说明；微信云函数环境变量请在云开发控制台配置。
# ADMIN_INIT_TOKEN=replace-with-a-random-secret-before-deploying-admin-init
# PLAN_REMINDER_TEMPLATE_ID=NvYH1zhsy9zwqhbgh6gZIXpXk0ndSDY0leulECtekUI
# PLAN_REMINDER_SUBSCRIPTION_TYPE=ONE_TIME
# REMINDER_TEMPLATE_TIME_KEY=time30
# REMINDER_TEMPLATE_CONTENT_KEY=thing2
# SOCIAL_CHECKIN_TEMPLATE_ID=NvYH1zhsy9zwqhbgh6gZIXpXk0ndSDY0leulECtekUI
# SOCIAL_CHECKIN_SUBSCRIPTION_TYPE=ONE_TIME
# SOCIAL_TEMPLATE_TIME_KEY=time30
# SOCIAL_TEMPLATE_CONTENT_KEY=thing2
# REMINDER_MESSAGE_PAGE=pages/today/index
# REMINDER_MINIPROGRAM_STATE=trial
# 反馈管理员的“我的”页面好友码，多个用英文逗号分隔。配置到 api 云函数环境变量。
# FEEDBACK_ADMIN_SHARE_CODES=ABC123
# 可选：管理员好友码。公开上线默认不会自动加任何管理员好友。
# DEFAULT_FRIEND_ADMIN_SHARE_CODE=ABC123
# DEFAULT_ADMIN_FRIEND_ENABLED=false

# 公测 Pro：是否给尚未领取过体验资格的用户自动发放 Beta Pro。
# BETA_ENROLLMENT_ENABLED=true
# 新用户默认 Beta Pro 体验天数，支持 1~365；修改后只影响之后首次领取的用户。
# BETA_PRO_DAYS=90

# Recovery / 补签卡规则。修改后服务端与 Pro 页面会读取同一份配置。
# MAKEUP_FREE_CARD_CAP=3
# MAKEUP_FREE_MONTHLY_GRANT=1
# MAKEUP_PRO_CARD_CAP=6
# MAKEUP_PRO_MONTHLY_GRANT=2

# 法律文本必须在上线前替换为真实信息；未填写时“关于/协议”页会提示尚未完成生产配置。
# LEGAL_OPERATOR_NAME=你的真实姓名或经营主体名称
# LEGAL_PRIVACY_CONTACT=privacy@example.com
# LEGAL_SERVICE_CONTACT=service@example.com
# LEGAL_EFFECTIVE_DATE=2026-09-28

# 永久 Pro 正式购买占位。默认关闭，未完成微信官方支付接入前不要开启。
# PRO_PURCHASE_ENABLED=false
# PRO_LIFETIME_PRICE=39.9
# PRO_VIRTUAL_PRODUCT_ID=zilv_pro_lifetime
